
&НаСервере
Процедура ПерепровестиЗачисления()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Пополнение.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Пополнение КАК Пополнение";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		// Вставить обработку выборки ВыборкаДетальныеЗаписи
		СсылкаНаДокумент = Выборка.Ссылка;
	    ДокОбъект = СсылкаНаДокумент.ПолучитьОбъект();
	    ДокОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	КонецЦикла;
	Сообщить("Зачисления успешно перепроведены");
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА

КонецПроцедуры

