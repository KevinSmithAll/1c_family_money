&НаКлиенте
Процедура Перепровести(Команда)
	Если Зачисления = Истина Тогда
		ПерепровестиЗачисления();
	КонецЕсли;

	Если СписыванияБаланса = Истина Тогда
		ПерепровестиСписывания();
	КонецЕсли;
	
	Если Траты = Истина Тогда 
		ПерепровестиТраты();	
	КонецЕсли;
	
КонецПроцедуры
