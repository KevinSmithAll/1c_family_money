
Функция ТекущийРасчётныйПериод() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчётныйПериод.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РасчётныйПериод КАК РасчётныйПериод
		|ГДЕ
		|	РасчётныйПериод.ДатаНачалаПериода <= &ТекущаяДата
		|	И РасчётныйПериод.ДатаКонцаПериода >= &ТекущаяДата";
	
	Запрос.УстановитьПараметр("ТекущаяДата", НачалоДня(ТекущаяДата()));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Ссылка;
	Иначе
		Сообщить("Расчетный период под текущую дату ещё не создан.");
		Возврат Неопределено;	
	КонецЕсли;	
КонецФункции

Функция РасчётныйПериодНаДату(Дата) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
