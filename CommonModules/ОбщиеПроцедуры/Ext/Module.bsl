		Сообщить("Расчетный период под текущую дату ещё не создан.");
		Возврат Неопределено;	
	КонецЕсли;	
КонецФункции

Функция ПолучитьДокументУстановщикЛимита(Период) Экспорт 
		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановитьЛимиты.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УстановитьЛимиты КАК УстановитьЛимиты
		|ГДЕ
		|	УстановитьЛимиты.РасчетныйПериод = &РасчетныйПериод";
	
	Запрос.УстановитьПараметр("РасчетныйПериод", Период);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	

КонецФункции	

