			<field>РасчетныйПериод</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    КатегорииРасходов.Ссылка КАК Категория,
    РасчётныеПериоды.Ссылка КАК РасчётныйПериод,
    РасчётныеПериоды.Наименование КАК ИмяПериода,
    Лимиты.Лимит КАК Лимит,
    ЕСТЬNULL(ДанныеТрат.Траты, 0) КАК Траты
ИЗ
    Справочник.КатегорииРасходов КАК КатегорииРасходов

    ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РасчётныйПериод КАК РасчётныеПериоды
    ПО ИСТИНА

    ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасчётныйПериод.УстановкаЛимитов КАК Лимиты
    ПО Лимиты.Ссылка = РасчётныеПериоды.Ссылка
        И Лимиты.Категория = КатегорииРасходов.Ссылка

    ЛЕВОЕ СОЕДИНЕНИЕ
    (
        ВЫБРАТЬ
            Обороты.РасчетныйПериод КАК РасчётныйПериод,
            Обороты.Категория КАК Категория,
            СУММА(Обороты.СуммаРасход) КАК Траты
        ИЗ
            РегистрНакопления.ОстаткиДенег.Обороты() КАК Обороты

        СГРУППИРОВАТЬ ПО
            Обороты.РасчетныйПериод,
            Обороты.Категория
    ) КАК ДанныеТрат

    ПО ДанныеТрат.РасчётныйПериод = РасчётныеПериоды.Ссылка
        И ДанныеТрат.Категория = КатегорииРасходов.Ссылка</query>
	</dataSet>
