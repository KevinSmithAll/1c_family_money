&НаСервере
Функция ПолучитьКатегорииНаПериод()
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановкаЛимитов.Категория КАК Категория
		|ИЗ
		|	Документ.РасчётныйПериод.УстановкаЛимитов КАК УстановкаЛимитов
		|ГДЕ
		|	УстановкаЛимитов.Ссылка = &РасчётныйПериод";
	
	Запрос.УстановитьПараметр("РасчётныйПериод", Объект.РасчетныйПериод);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Массив = Новый Массив();
	
	Пока Выборка.Следующий() Цикл
		Массив.Добавить(Выборка.Категория);
	КонецЦикла;
	Возврат Массив;
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
КонецФункции


&НаСервереБезКонтекста 
Функция ПолучитьОстатокПоКатегории(Категория, РасчетныйПериод)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОстаткиДенегОстатки.Категория КАК Категория,
		|	ОстаткиДенегОстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.ОстаткиДенег.Остатки(
		|			,
		|			РасчетныйПериод = &РасчетныйПериод
		|				И Категория = &Категория) КАК ОстаткиДенегОстатки";
	
	Запрос.УстановитьПараметр("Категория", Категория);
	Запрос.УстановитьПараметр("РасчетныйПериод", РасчетныйПериод);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаОстаток;	
	Иначе
		Возврат 0;	
	КонецЕсли;
КонецФункции

